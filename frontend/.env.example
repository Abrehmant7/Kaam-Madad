# Frontend development settings (Vite). Copy to `.env.local` only if you need
# to change something; the defaults below work with the documented setup.
#   Linux/macOS:        cp .env.example .env.local
#   Windows PowerShell: Copy-Item .env.example .env.local
#
# Never put secrets in frontend env files: anything prefixed VITE_ is bundled
# into JavaScript that every visitor can read.

# Where the Vite dev server proxies /api, /admin and /static (the Django dev server).
# Not exposed to browser code (no VITE_ prefix). Used only by `npm run dev`.
DEV_BACKEND_URL=http://127.0.0.1:8000
