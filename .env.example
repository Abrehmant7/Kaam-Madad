# Kaam Madad backend + Docker Compose configuration.
# (Database values below keep the internal identifier "roshan_rozgaar", the project's former name.)
#
# Copy this file to `.env` in the repository root and adjust values:
#   Linux/macOS:        cp .env.example .env
#   Windows PowerShell: Copy-Item .env.example .env
#
# `.env` is git-ignored. Never commit real secrets. Values already present in
# the process environment take precedence over values in `.env`.
# Module M1 needs NO speech, OCR, OTP, NADRA or other provider keys.

# --------------------------------------------------------------------------
# Django
# --------------------------------------------------------------------------
# Settings module. Development is the default for manage.py; wsgi/asgi default
# to production. Options: config.settings.development | config.settings.production
# | config.settings.test
# DJANGO_SETTINGS_MODULE=config.settings.development

# Required in production (50+ random characters). Development falls back to an
# insecure local-only key when this is empty. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Comma-separated host names this deployment answers to. Required in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated scheme+host origins trusted for CSRF-protected requests.
# In development the Vite server (http://localhost:5173) proxies to Django.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Log level for application loggers: DEBUG | INFO | WARNING | ERROR
DJANGO_LOG_LEVEL=INFO

# Number of trusted reverse proxies in front of Django. Rate limiting uses the
# client IP; with 0 it uses the direct connection address and ignores
# X-Forwarded-For (which clients could forge). Set to 1 behind one proxy.
DJANGO_NUM_PROXIES=0

# --------------------------------------------------------------------------
# Deployment mode and phone verification (Module M2)
# --------------------------------------------------------------------------
# live = real users. demo = an explicitly separate demonstration deployment:
#   new accounts are flagged as demo and the UI shows a persistent demo banner.
# Defaults: development = demo, production = live.
# APP_DEPLOYMENT_MODE=demo

# demo         = simulated codes: NO SMS is sent; the code is shown on a labelled
#                demo screen. Allowed ONLY with APP_DEPLOYMENT_MODE=demo —
#                startup fails otherwise.
# unconfigured = no SMS provider; phone confirmation reports "not available".
# Defaults: development = demo, production = unconfigured.
# No real SMS provider is integrated yet (see docs/architecture.md).
# PHONE_VERIFICATION_PROVIDER=demo

# --------------------------------------------------------------------------
# Audio and AI providers (Module M3) — each capability is configured separately
# --------------------------------------------------------------------------
# fixture      = deterministic SIMULATED results, labelled in the UI; only allowed
#                with APP_DEPLOYMENT_MODE=demo (startup fails otherwise).
# unconfigured = honest "not available" errors.
# Defaults: development = fixture, production = unconfigured.
# SPEECH_TO_TEXT_PROVIDER=fixture       # fixture | elevenlabs | gemini | unconfigured
# INTERPRETATION_PROVIDER=fixture       # fixture | groq | gemini | unconfigured
# TEXT_TO_SPEECH_PROVIDER=fixture       # fixture | elevenlabs | azure | unconfigured
#
# PITCH CONFIGURATION (ElevenLabs for speech, Groq for text AI; no Gemini key needed).
# Uncomment these four lines and fill ELEVENLABS_API_KEY, ELEVENLABS_VOICE_ID and GROQ_API_KEY below:
# SPEECH_TO_TEXT_PROVIDER=elevenlabs
# TEXT_TO_SPEECH_PROVIDER=elevenlabs
# INTERPRETATION_PROVIDER=groq
# AGREEMENT_CHECK_PROVIDER=groq

# Groq — text AI: job/onboarding suggestions with the Urdu job description, and the quote agreement check.
# API key: console.groq.com > API Keys. Server-side only. Strict JSON Schema output (openai/gpt-oss-120b).
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b                 # default for both uses below
# GROQ_INTERPRETATION_MODEL=openai/gpt-oss-120b
# GROQ_AGREEMENT_MODEL=openai/gpt-oss-120b
# GROQ_INTERPRETATION_REASONING_EFFORT=low       # low | medium | high
# GROQ_AGREEMENT_REASONING_EFFORT=high          # a Groq schema rejection is retried once at medium
# GROQ_MAX_COMPLETION_TOKENS=2500                # suggestions; includes reasoning. The free tier reserves the requested
# GROQ_AGREEMENT_MAX_COMPLETION_TOKENS=3500      #   maximum against 8000 tokens/minute, so keep these modest
# GROQ_TEMPERATURE=0.2
# GROQ_API_BASE=https://api.groq.com/openai/v1

# Google Gemini API — speech-to-text (audio understanding) and structured interpretation (optional alternative).
# Create a key at https://aistudio.google.com/apikey (a free tier exists). Server-side only.
GEMINI_API_KEY=
# GEMINI_STT_MODEL=gemini-3.8-flash
# GEMINI_INTERPRETATION_MODEL=gemini-3.8-flash
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
# GEMINI_API_REVISION=2026-05-20

# Azure AI Speech — text-to-speech with Urdu (Pakistan) neural voices.
# Create a Speech resource in the Azure portal; copy its key and region (e.g. centralindia).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# AZURE_TTS_VOICE_UR=ur-PK-UzmaNeural     # or ur-PK-AsadNeural
# AZURE_TTS_VOICE_EN=en-IN-NeerjaNeural
# AZURE_TTS_OUTPUT_FORMAT=riff-24khz-16bit-mono-pcm

# ElevenLabs — read-aloud with eleven_v3 (TEXT_TO_SPEECH_PROVIDER=elevenlabs) and speech-to-text with
# Scribe v3 (SPEECH_TO_TEXT_PROVIDER=elevenlabs). One key for both.
# API key: elevenlabs.io > Developers > API keys. If you restrict the key's scope, enable BOTH
# "Text to Speech" (read-aloud) and "Speech to Text" (transcription). Server-side only.
# Voice ID: any voice in your ElevenLabs "My Voices" list (copy its ID). One voice reads Urdu and English.
# Free plans: use a premade/default voice (Voice Library voices need a paid plan through the API).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_STT_MODEL=scribe_v3
# Urdu script: scribe_v3 returned Urdu speech in Devanagari (Hindi script) in our live check. Such a transcript is
# retried once with this model and language_code=ur (scribe_v2 returned Urdu script). Empty = refuse instead.
# ELEVENLABS_STT_URDU_FALLBACK_MODEL=scribe_v2
# ELEVENLABS_MODEL_ID=eleven_v3
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128   # mp3_* or wav_* only; 44.1 kHz WAV needs a Pro plan
# ELEVENLABS_API_BASE=https://api.elevenlabs.io
# ELEVENLABS_ZERO_RETENTION=false          # true = enable_logging=false (ElevenLabs enterprise accounts only)

# CNIC OCR (Module M4): Tesseract installed on THIS host (no external service). tesseract | unconfigured
# CNIC_OCR_PROVIDER=tesseract
# Full path or a name on PATH. Windows default install is found automatically:
#   C:\Program Files\Tesseract-OCR\tesseract.exe      Linux: /usr/bin/tesseract
# TESSERACT_CMD=tesseract
# TESSERACT_LANG=eng            # needs eng.traineddata (tesseract --list-langs)
# OCR_TIMEOUT_SECONDS=20        # total budget per scan, including rotation retries

# Identity registry (Module M4): demo_registry = FICTIONAL records, demo deployments only | unconfigured.
# Defaults: development = demo_registry, production = unconfigured. NADRA is not integrated.
# IDENTITY_VERIFICATION_PROVIDER=demo_registry

# Agreement check for quotations (Module M7): compares the shared request, approved message
# texts and the structured quote, and asks for clarification when they contradict each other.
# fixture = SIMULATED keyword rules (demo only) | groq | gemini | unconfigured ("could not run" + manual review).
# Defaults: development = fixture, production = unconfigured.
# AGREEMENT_CHECK_PROVIDER=fixture
# GEMINI_AGREEMENT_MODEL=gemini-3.8-flash     # defaults to GEMINI_INTERPRETATION_MODEL
# GEMINI_AGREEMENT_MAX_TOKENS=6000            # includes the model's reasoning; 1500 truncated live output
# A sent quote version can be accepted for this many hours, or until its start time if sooner.
# QUOTE_VALIDITY_HOURS=24
# A check still "running" after this many seconds is shown as "could not run" (re-run or manual review).
# AGREEMENT_CHECK_STALE_SECONDS=180
# Arrival codes (Module M8): minutes a code stays valid, and wrong attempts allowed per code.
# ARRIVAL_CODE_TTL_MINUTES=15
# ARRIVAL_CODE_MAX_ATTEMPTS=5
# Reports (Module M10): evidence content of reports closed longer than this is removed by
# `python manage.py purge_report_evidence` (never for open cases or active disputes).
# REPORT_EVIDENCE_RETENTION_DAYS=180

# Per-attempt timeout (seconds) and retries for every provider call.
# AI_PROVIDER_TIMEOUT_SECONDS=20
# AI_PROVIDER_MAX_RETRIES=1

# Folder for private uploads (audio now; CNIC images in M4). Never served by URL.
# PRIVATE_MEDIA_ROOT=

# --------------------------------------------------------------------------
# PostgreSQL (used by Django AND by docker-compose.yml)
# --------------------------------------------------------------------------
# With Docker Compose these values also create the database/user on first start.
# To use an existing PostgreSQL server instead, point these at that server
# (for a default local install: POSTGRES_HOST=127.0.0.1, POSTGRES_PORT=5432).
POSTGRES_DB=roshan_rozgaar
POSTGRES_USER=roshan_rozgaar
POSTGRES_PASSWORD=change-me-local-dev-only
# Use 127.0.0.1, not "localhost": Docker Desktop publishes the port on IPv4 only,
# and libpq tries IPv6 (::1) first for "localhost", where the attempt hangs until
# POSTGRES_CONNECT_TIMEOUT expires — measured at +5 s on EVERY new connection.
POSTGRES_HOST=127.0.0.1
# 5434 = Docker Compose default host port (avoids a local server on 5432 and other
# projects' Compose databases that often use 5433). Change it here if 5434 is in use.
POSTGRES_PORT=5434
# Seconds to wait per address when opening a database connection. Also bounds
# /health/ready/, which must answer well within the frontend's 10 s request timeout.
POSTGRES_CONNECT_TIMEOUT=3
# Optional libpq SSL mode for managed databases, e.g. require | verify-full. Empty = driver default.
POSTGRES_SSLMODE=
# Seconds to keep database connections open between requests (0 = close each request).
DJANGO_CONN_MAX_AGE=0

# --------------------------------------------------------------------------
# Production-only security options (ignored by development settings)
# --------------------------------------------------------------------------
# Redirect HTTP to HTTPS inside Django. Set false only if a proxy already enforces it.
# DJANGO_SECURE_SSL_REDIRECT=true
# Trust X-Forwarded-Proto=https from a reverse proxy/platform that sets it.
# DJANGO_SECURE_PROXY_SSL_HEADER=false
# HTTP Strict Transport Security duration in seconds (raise after HTTPS is confirmed).
# DJANGO_SECURE_HSTS_SECONDS=3600
# Path to the built frontend (defaults to ../frontend/dist relative to backend/).
# FRONTEND_DIST_DIR=
